meta {
  name: List shipments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/shipments?_page=1&_per_page=25&_sort=-updated_at
  body: none
  auth: none
}

params:query {
  _page: 1
  _per_page: 25
  _sort: -updated_at
}

docs {
  ```ts
  type Shipment = {
    id: string;
    client_name: string;
    label: string;
    status: "OPEN" | "IN_TRANSIT" | "DELIVERED";
    arrival_date: string;
    delivery_by_date: string;
    eta: string;
    updated_at: string;
    warehouse_id: string;
    assignment_id: string | null;
    lat: number;
    lng: number;
  };

  type PaginatedShipments = {
    first: number;
    prev: number | null;
    next: number | null;
    last: number;
    pages: number;
    items: number;
    data: Shipment[];
  };

  type Response = {
    data: { data: PaginatedShipments };
    message: string;
    status: "SUCCESS";
  };
  ```
}
