meta {
  name: Delete shipment
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/shipments/{{createdShipmentId}}
  body: none
  auth: none
}

docs {
  ```ts
  type Shipment = {
    id: string;
    client_name: string;
    label: string;
    status: "OPEN" | "IN_TRANSIT" | "DELIVERED";
    arrival_date: string;
    delivery_by_date: string;
    eta: string;
    updated_at: string;
    warehouse_id: string;
    assignment_id: string | null;
    lat: number;
    lng: number;
  };

  type Response = {
    data: { data: Shipment };
    message: string;
    status: "SUCCESS";
  };
  ```
}
