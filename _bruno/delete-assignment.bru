meta {
  name: Delete assignment
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/api/assignments/{{createdAssignmentId}}
  body: none
  auth: none
}

docs {
  ```ts
  type Assignment = {
    id: string;
    label: string;
    status: "OPEN" | "COMPLETED";
    clients: string[];
    shipment_count: number;
    updated_at: string;
  };

  type Response = {
    data: { data: Assignment };
    message: string;
    status: "SUCCESS";
  };
  ```
}
