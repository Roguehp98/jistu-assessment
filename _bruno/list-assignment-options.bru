meta {
  name: List assignment options
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/assignments/options
  body: none
  auth: none
}

docs {
  Returns every open assignment, sorted by label, for assignment selection controls.

  ```ts
  type AssignmentOption = {
    id: string;
    label: string;
  };

  type Response = {
    data: { data: AssignmentOption[] };
    message: string;
    status: "SUCCESS";
  };
  ```
}
