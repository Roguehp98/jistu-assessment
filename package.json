{
	"name": "jistu-assessment",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"clean": "turbo clean",
		"predev": "./_scripts/setup-env.sh",
		"dev": "dotenv -- turbo run dev",
		"kill:port": "./_scripts/kill-port.sh 3000 3001",
		"lint:apply": "biome check --write --unsafe .",
		"lint:check": "biome check .",
		"prepare": "husky",
		"test": "dotenv -- turbo test --ui=stream"
	},
	"nano-staged": {
		"*": [
			"biome check --write --skip-parse-errors --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"package.json": "sort-package-json",
		"**/package.json": "sort-package-json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"nano-staged": "^0.9.0",
		"sort-package-json": "^3.6.0",
		"turbo": "^2.10.12",
		"typescript": "7.0.2"
	},
	"packageManager": "npm@11.7.0",
	"engines": {
		"node": ">=24"
	}
}
