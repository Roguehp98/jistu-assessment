{
	"name": "jistu-assessment",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"lint": "turbo run lint",
		"prepare": "husky"
	},
	"nano-staged": {
		"*": [
			"biome check --write --skip-parse-errors --no-errors-on-unmatched --files-ignore-unknown=true"
		],
		"package.json": "sort-package-json",
		"**/package.json": "sort-package-json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"dotenv-cli": "^11.0.0",
		"husky": "^9.1.7",
		"nano-staged": "^0.9.0",
		"sort-package-json": "^3.6.0",
		"turbo": "^2.10.12",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.12.1"
		}
	}
}
